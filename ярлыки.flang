модуль «Ярлыки»

// ЯРЛЫКИ НА КОМАНДЫ этого дерева — здесь, а не в Makefile.
//
// Ярлык — это имя, за которым стоит строка команды. Строки эти лежали в
// `Makefile`, и звать их приходилось через `make`. make не делал при этом
// ничего сверх подстановки строки: ни одной зависимости между целями здесь не
// было, ни одного правила по времени файла — только `.PHONY` и список команд.
// Приём взят у самого языка (`flang:ярлык` и `flang:ярлыки.flang`): тонкая
// оболочка на sh плюс программа на flang.
//
// Список — ПРОГРАММА, а не файл настроек: имена и строки проверены типами, у
// каждой разборной функции есть примеры, а «Сколько ярлыков» несёт число
// обещанием, а не прозой. В оболочке `ярлык` списка НЕТ ни одной строкой — она
// только спрашивает двоичный и запускает ответ.
//
//   ./ярлык                  весь список
//   ./ярлык проверка         выполнить ярлык
//
// ── Почему оболочка, а не сам flang ────────────────────────────────────────
// Ровно по тем же четырём причинам, что названы в дереве языка: у `flang io`
// нет способа принять довод, хозяин планов копит вывод потомка до конца,
// экрана у него нет вовсе, а код возврата потомка до хозяина не доезжает.
// Ярлыку нужно обратное: живой вывод и настоящий код возврата. Поэтому
// запускает оболочка, а решает — flang.
//
// ── Чем ЭТА оболочка проще той, что в дереве языка ─────────────────────────
// Там первый ярлык не может быть на flang: чтобы прочитать список, нужен
// двоичный, а его ещё нет, и ярлык «сборка» приходится знать самой оболочке.
// Здесь такой развязки не нужно: компилятор — ВНЕШНЕЕ условие библиотеки, он
// стоит на PATH или указан в FLANG/FLANG_HOME. Нет его — оболочка говорит об
// этом и уходит кодом 3, а не пытается что-то собрать.
//
// ── Имена файлов ───────────────────────────────────────────────────────────
// `ярлык` и `ярлыки.flang` — единственные два кириллических имени в дереве, и
// взяты они у языка дословно: `./ярлык проверка` — это то, что человек НАБИРАЕТ
// руками, а не внутреннее имя модуля. Остальные имена по-прежнему английские.

объект «Ярлык»
  «имя»: строка
  «команда»: строка
  «зачем»: строка

// Весь список. Порядок здесь — порядок вывода.
//
// ЧТО ЗДЕСЬ НЕ ПЕРЕЧИСЛЕНО НИ РАЗУ — ИМЕНА МОДУЛЕЙ. `Makefile` держал их
// списком (`МОДУЛИ = screen colour format history tabs scroll`), и список этот
// мог разойтись с деревом молча: новый модуль не проверялся бы и не печатался,
// а всё оставалось бы зелёным. Здесь вместо списка стоит `flang/*.flang` —
// расходиться нечему.
тотальная функция «Все ярлыки»
  возвращает список «Ярлык»
  обеспечивает «ярлыков семь» (длина результат) равен 7
  [запись «Ярлык» с «имя» равным "проверка" и «команда» равным "for m in flang/*.flang tools/licensing.flang ярлыки.flang; do echo \"== $m\"; $FLANG check \"$m\" || exit 1; $FLANG test \"$m\" || exit 1; done" и «зачем» равным "разбор, типы, завершаемость и примеры: модули, сторож, ярлыки",
   запись «Ярлык» с «имя» равным "ведомость" и «команда» равным "for m in flang/*.flang; do echo \"== $m\"; $FLANG check --proof \"$m\" || exit 1; done" и «зачем» равным "чем несётся каждое обещание: доказано, сетка N или объявлено",
   запись «Ярлык» с «имя» равным "печать" и «команда» равным "rm -rf out-go out-c; for f in flang/*.flang; do m=$(basename \"$f\" .flang); $FLANG emit \"$f\" --target go --out \"out-go/$m\" || exit 1; grep -rl flangprogram \"out-go/$m\" | while read -r x; do sed -i.bak \"s|flangprogram|flang$m|g\" \"$x\" && rm -f \"$x.bak\"; done; ( cd \"out-go/$m\" && test -z \"$(gofmt -l .)\" && go vet ./... && go build ./... ) || exit 1; $FLANG emit \"$f\" --target c --out \"out-c/$m\" || exit 1; make -C \"out-c/$m\" || exit 1; done" и «зачем» равным "печать в Go и в C и сборка обеих: gofmt, go vet, go build, cc",
   запись «Ярлык» с «имя» равным "лицензии" и «команда» равным "cd tools && $FLANG io licensing.flang" и «зачем» равным "лицензионный сторож: SPDX, копилефт, чужие языки",
   запись «Ярлык» с «имя» равным "пределы" и «команда» равным "d=${TMPDIR:-/tmp}/flang-tui-predely; rm -rf $d; $FLANG emit flang/screen.flang --target c --out $d >/dev/null 2>&1 || { echo \"печать в C отказала\" >&2; exit 1; }; make -C $d >/dev/null 2>&1 || { echo \"сборка напечатанного C отказала\" >&2; exit 1; }; a=$(printf '{\"fn\":\"Полоса\",\"args\":[{\"n\":\"0.5\"},{\"n\":\"9999\"},{\"s\":\"#\"},{\"s\":\"-\"}]}' | $d/flang_cli); echo \"$a\" | grep -q '\"ok\":true' || { echo \"полоса шириной 9999 обязана считаться\" >&2; exit 1; }; echo \"ширина  9999: посчитана\"; b=$(printf '{\"fn\":\"Полоса\",\"args\":[{\"n\":\"0.5\"},{\"n\":\"10000\"},{\"s\":\"#\"},{\"s\":\"-\"}]}' | $d/flang_cli); echo \"$b\" | grep -q FLANG_RECURSION_LIMIT || { echo \"полоса шириной 10000 обязана упереться в предел глубины\" >&2; exit 1; }; echo \"ширина 10000: предел глубины вызовов 10000, как и записано в README\"; rm -rf $d" и «зачем» равным "Ф3: где кончается вшитый предел глубины напечатанной программы",
   запись «Ярлык» с «имя» равным "чисто" и «команда» равным "rm -rf out-go out-c" и «зачем» равным "убрать напечатанное",
   запись «Ярлык» с «имя» равным "всё" и «команда» равным "./ярлык проверка && ./ярлык ведомость && ./ярлык печать && ./ярлык пределы && ./ярлык лицензии" и «зачем» равным "весь прогон подряд: проверка, ведомость, печать, пределы, лицензии"]

тотальная функция «Команда ярлыка»
  принимает ярлык: строка
  возвращает строка
  пример «Известное имя отдаёт свою строку»
    дано ярлык равно "чисто"
    ожидается "rm -rf out-go out-c"
  пример «Неизвестное имя — пусто»
    дано ярлык равно "make печать"
    ожидается ""
  пример «Пустое имя — пусто»
    дано ярлык равно ""
    ожидается ""
  свёртка («Все ярлыки») начиная с "" как акк и я
    если (я.«имя») равен ярлык то (я.«команда») иначе акк

// Сколько ярлыков всего. Число живёт здесь, а не в прозе: проза его цитирует.
тотальная функция «Сколько ярлыков»
  возвращает нат
  обеспечивает «ярлыков семь» результат равен 7
  пример «Семь»
    ожидается 7
  длина («Все ярлыки»)

// Отступ до второго столбца. Самое длинное имя — «ведомость», в нём 9 знаков,
// поэтому столбец стоит на 12.
тотальная функция «Отступ»
  принимает имя: строка
  возвращает строка
  обеспечивает «длинное имя получает один пробел» если (длина имя) не меньше 12 то (результат равен " ") иначе да
  пример «Короткое имя дополняется до столбца»
    дано имя равно "чисто"
    ожидается "       "
  пример «Имя длиннее столбца получает один пробел, а не отрицательную длину»
    дано имя равно "очень длинное имя ярлыка"
    ожидается " "
  если (длина имя) не меньше 12
    то " "
    иначе подстрока "            " с 1 по (12 минус (длина имя))

// Весь список одной строкой: имя, отступ, зачем. Печатает его оболочка.
тотальная функция «Перечень»
  возвращает строка
  обеспечивает «в перечне столько же строк, сколько ярлыков» (длина (разделить результат по "\n")) равен («Сколько ярлыков»)
  соединить (отобразить («Все ярлыки») как я → (соединить [я.«имя», («Отступ» от (я.«имя»)), я.«зачем»] по "")) по "\n"
