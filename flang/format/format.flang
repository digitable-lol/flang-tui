// ─────────────────────────── длительности ───────────────────────────

// HumanDuration: «5д 03:14» либо «03:14». Секунд в выводе нет вовсе, а
// неположительный ввод даёт пустую строку — не прочерк.
тотальная функция «Длительность»
  принимает секунды: число
  возвращает строка
  пример «Минута с секундой»
    дано секунды равно 61
    ожидается "00:01"
  пример «Час»
    дано секунды равно 3600
    ожидается "01:00"
  пример «Сутки с часом»
    дано секунды равно 90061
    ожидается "1д 01:01"
  пример «Двадцать четыре дня»
    дано секунды равно 2100448
    ожидается "24д 07:27"
  пример «Ноль — пустая строка»
    дано секунды равно 0
    ожидается ""
  пример «Отрицательное — пустая строка»
    дано секунды равно -5
    ожидается ""
  // Примеры ниже сняты с эталона digitdisk 7ea03ed: входы выбраны по границам, ответы — его.
  пример «-100 с»
    дано секунды равно -100
    ожидается ""
  пример «-1 с»
    дано секунды равно -1
    ожидается ""
  пример «0 с»
    дано секунды равно 0
    ожидается ""
  пример «0.5 с»
    дано секунды равно 0.5
    ожидается "00:00"
  пример «1 с»
    дано секунды равно 1
    ожидается "00:00"
  пример «1.9 с»
    дано секунды равно 1.9
    ожидается "00:00"
  пример «59 с»
    дано секунды равно 59
    ожидается "00:00"
  пример «59.999 с»
    дано секунды равно 59.999
    ожидается "00:00"
  пример «60 с»
    дано секунды равно 60
    ожидается "00:01"
  пример «61 с»
    дано секунды равно 61
    ожидается "00:01"
  пример «3599 с»
    дано секунды равно 3599
    ожидается "00:59"
  пример «3600 с»
    дано секунды равно 3600
    ожидается "01:00"
  пример «3601 с»
    дано секунды равно 3601
    ожидается "01:00"
  пример «86399 с»
    дано секунды равно 86399
    ожидается "23:59"
  пример «86399.5 с»
    дано секунды равно 86399.5
    ожидается "23:59"
  пример «86400 с»
    дано секунды равно 86400
    ожидается "1д 00:00"
  пример «86401 с»
    дано секунды равно 86401
    ожидается "1д 00:00"
  пример «2999992 с»
    дано секунды равно 2999992
    ожидается "34д 17:19"
  «Длительность языком» от секунды и "ru"

// report/places.go: «сколько прошло» — минуты до часа, часы до двух суток,
// дальше сутки. Усечение, а не округление.
тотальная функция «Прошло»
  принимает секунды: число
  возвращает строка
  пример «Минуты»
    дано секунды равно 300
    ожидается "5 мин"
  пример «Часы»
    дано секунды равно 7200
    ожидается "2 ч"
  пример «Сутки»
    дано секунды равно 200000
    ожидается "2 дн"
  // Примеры ниже сняты с эталона digitdisk 7ea03ed: входы выбраны по границам, ответы — его.
  пример «0 с»
    дано секунды равно 0
    ожидается "0 мин"
  пример «1 с»
    дано секунды равно 1
    ожидается "0 мин"
  пример «59 с»
    дано секунды равно 59
    ожидается "0 мин"
  пример «60 с»
    дано секунды равно 60
    ожидается "1 мин"
  пример «61 с»
    дано секунды равно 61
    ожидается "1 мин"
  пример «3599 с»
    дано секунды равно 3599
    ожидается "59 мин"
  пример «3600 с»
    дано секунды равно 3600
    ожидается "1 ч"
  пример «3601 с»
    дано секунды равно 3601
    ожидается "1 ч"
  пример «86399 с»
    дано секунды равно 86399
    ожидается "23 ч"
  пример «86400 с»
    дано секунды равно 86400
    ожидается "24 ч"
  пример «86401 с»
    дано секунды равно 86401
    ожидается "24 ч"
  пример «172800 с»
    дано секунды равно 172800
    ожидается "2 дн"
  пример «399970 с»
    дано секунды равно 399970
    ожидается "4 дн"
  если секунды меньше 3600
    то соединить (соединить (к строке («Деление нацело» от секунды и 60)) с " ") с "мин"
    иначе если секунды меньше 172800
      то соединить (соединить (к строке («Деление нацело» от секунды и 3600)) с " ") с "ч"
      иначе соединить (соединить (к строке («Целое к нулю» от ((секунды делить на 3600) делить на 24))) с " ") с "дн"

// ui/screen.go: сколько длился замер. Меньше секунды — целые миллисекунды,
// дальше — секунды с одним знаком.
