модуль «Colour»

// Цветовые последовательности терминала: истинный цвет, укладка в куб
// xterm-256 и шестнадцать базовых.
//
// ПОБИТОВЫХ ОПЕРАЦИЙ ЗДЕСЬ НЕТ, и это не обход, а свойство задачи: истинный
// цвет — десятичная запись трёх каналов, а куб 6×6×6 и серая лесенка —
// целочисленное умножение и деление. И то и другое в языке есть.
//
// Эталон — digitdisk, host/internal/ui/theme.go: Theme.seq и cube256. Ни одна
// из двух функций Go побитовых операций не содержит.

тотальная функция «Целое от»
  принимает значение: число
  возвращает число
  обеспечивает «целое — само число без остатка от единицы» результат равен (значение минус (значение остаток от 1))
  пример «Дробь отбрасывается»
    дано значение равно 5.5
    ожидается 5
  значение минус (значение остаток от 1)

// Целочисленное деление с усечением к нулю — ровно то, что делает `/` у int в Go.
тотальная функция «Деление нацело»
  принимает делимое: число, делитель: число
  возвращает число
  пример «Точное деление»
    дано делимое равно 12
    дано делитель равно 4
    ожидается 3
  пример «С остатком»
    дано делимое равно 13
    дано делитель равно 4
    ожидается 3
  если делитель равен 0
    то 0
    иначе «Целое от» от (делимое делить на делитель)

тотальная функция «Разница по модулю»
  принимает первое: число, второе: число
  возвращает число
  обеспечивает «разница неотрицательна» результат не меньше 0
  пример «Меньшее из большего»
    дано первое равно 3
    дано второе равно 10
    ожидается 7
  если первое больше второе
    то первое минус второе
    иначе второе минус первое

// Куб 6×6×6 либо серая лесенка — дословно cube256 из theme.go.
тотальная функция «Ступень канала»
  принимает канал: число
  возвращает число
  пример «Ноль»
    дано канал равно 0
    ожидается 0
  пример «Полный»
    дано канал равно 255
    ожидается 5
  пример «Середина»
    дано канал равно 128
    ожидается 3
  «Деление нацело» от ((канал умножить на 5) плюс 127) и 255

тотальная функция «Куб 256»
  принимает красный: число, зелёный: число, синий: число
  возвращает число
  обеспечивает «код лежит в палитре xterm-256» (результат не меньше 16) и притом (результат не больше 255)
  пример «Чистый красный»
    дано красный равно 255
    дано зелёный равно 0
    дано синий равно 0
    ожидается 196
  пример «Почти чёрный — серая лесенка снизу»
    дано красный равно 2
    дано зелёный равно 3
    дано синий равно 4
    ожидается 16
  пример «Белый — серая лесенка сверху»
    дано красный равно 255
    дано зелёный равно 255
    дано синий равно 255
    ожидается 231
  пример «Серый посередине»
    дано красный равно 128
    дано зелёный равно 130
    дано синий равно 132
    ожидается 243
  если ((«Разница по модулю» от красный и зелёный) меньше 12) и притом ((«Разница по модулю» от зелёный и синий) меньше 12) и притом ((«Разница по модулю» от красный и синий) меньше 12)
    то
      пусть серый равно («Деление нацело» от ((красный плюс зелёный) плюс синий) и 3)
      если серый меньше 8
        то 16
        иначе если серый больше 248
          то 231
          иначе 232 плюс («Деление нацело» от ((серый минус 8) умножить на 23) и 240)
    иначе 16 плюс ((36 умножить на («Ступень канала» от красный)) плюс ((6 умножить на («Ступень канала» от зелёный)) плюс («Ступень канала» от синий)))

тотальная функция «Эск»
  возвращает строка
  пример «Знак с кодом двадцать семь»
    ожидается "\u001b"
  символ по коду 27

// Истинный цвет: ESC [ 38;2;R;G;B m — одна десятичная запись на канал.
тотальная функция «Цвет истинный»
  принимает фоном: признак, красный: число, зелёный: число, синий: число
  возвращает строка
  обеспечивает «последовательность кончается буквой m» (подстрока результат с (длина результат) по (длина результат)) равен "m"
  пример «Передний план»
    дано фоном равно нет
    дано красный равно 10
    дано зелёный равно 20
    дано синий равно 30
    ожидается "\u001b[38;2;10;20;30m"
  пример «Фон»
    дано фоном равно да
    дано красный равно 1
    дано зелёный равно 2
    дано синий равно 3
    ожидается "\u001b[48;2;1;2;3m"
  соединить [(«Эск»), "[", (к строке (если фоном то 48 иначе 38)), ";2;", (к строке красный), ";", (к строке зелёный), ";", (к строке синий), "m"] по ""

тотальная функция «Цвет из палитры»
  принимает фоном: признак, красный: число, зелёный: число, синий: число
  возвращает строка
  обеспечивает «последовательность кончается буквой m» (подстрока результат с (длина результат) по (длина результат)) равен "m"
  пример «Красный в палитре»
    дано фоном равно нет
    дано красный равно 255
    дано зелёный равно 0
    дано синий равно 0
    ожидается "\u001b[38;5;196m"
  соединить [(«Эск»), "[", (к строке (если фоном то 48 иначе 38)), ";5;", (к строке («Куб 256» от красный и зелёный и синий)), "m"] по ""

тотальная функция «Цвет из шестнадцати»
  принимает фоном: признак, ансиКод: число
  возвращает строка
  пример «Зелёный передним планом»
    дано фоном равно нет
    дано ансиКод равно 32
    ожидается "\u001b[32m"
  пример «Зелёный фоном»
    дано фоном равно да
    дано ансиКод равно 32
    ожидается "\u001b[42m"
  соединить [(«Эск»), "[", (к строке (если фоном то (ансиКод плюс 10) иначе ансиКод)), "m"] по ""
